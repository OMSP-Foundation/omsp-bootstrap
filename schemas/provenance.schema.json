{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsp.foundation/schemas/provenance.schema.json",
  "title": "OMSP Shared Provenance Definitions",
  "description": "Shared $defs for maritime instance schemas (WP-0078). Implements the binding provenance rules of OMSP-PLANNING-GOLDEN-PATH-0001 section 4.3: every non-unknown value carries source ID, authority class, confidence, retrieval date and applicability; unknowns are explicit, never omitted. Advisory validation only; no certification claim.",
  "$defs": {
    "schema-version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "type": "object",
      "required": ["source_id", "authority_class", "confidence", "retrieval_date", "applicability"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^source:[a-z0-9][a-z0-9:._-]*$"},
        "authority_class": {
          "enum": ["reference", "sourced-secondary", "sourced-manufacturer", "verified-design", "verified-as-built"]
        },
        "confidence": {"enum": ["high", "medium", "low"]},
        "retrieval_date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "applicability": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "known-value": {
      "type": "object",
      "required": ["value", "provenance"],
      "properties": {
        "value": {
          "oneOf": [
            {"type": "number"},
            {"type": "boolean"},
            {
              "type": "string",
              "minLength": 1,
              "not": {"enum": ["unknown", "<to-be-sourced>"]}
            }
          ]
        },
        "unit": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "unknown-marker": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"const": "unknown"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenanced-value": {
      "type": "object",
      "oneOf": [
        {"$ref": "#/$defs/known-value"},
        {"$ref": "#/$defs/unknown-marker"}
      ]
    },
    "attribute-map": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/provenanced-value"}
    }
  }
}
