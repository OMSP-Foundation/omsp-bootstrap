{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsp.foundation/schemas/checklist-lint-result.schema.json",
  "title": "OMSP Checklist Lint Result",
  "type": "object",
  "required": ["schema_version", "checklist", "status", "findings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "checklist": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "gate-blocked", "tool-error"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "message", "fingerprint"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^CHK-[A-Z]+-[0-9]{3}$"},
          "severity": {"enum": ["info", "warning", "error", "gate"]},
          "item_id": {"type": ["string", "null"]},
          "message": {"type": "string", "minLength": 1},
          "evidence_reference": {"type": ["string", "null"]},
          "exception_reference": {"type": ["string", "null"]},
          "remediation": {"type": ["string", "null"]},
          "fingerprint": {"type": "string", "minLength": 8}
        },
        "additionalProperties": false
      }
    },
    "approval_reference": {
      "description": "Optional human approval record. Tooling must not synthesize this value.",
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
