{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omsp.foundation/schemas/traceability-report.schema.json",
  "title": "OMSP Traceability Validation Report",
  "type": "object",
  "required": ["schema_version", "tool", "repository", "summary", "findings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["name", "commit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "branch": {"type": "string"},
        "commit": {"type": "string", "minLength": 7}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["status", "errors", "warnings"],
      "properties": {
        "status": {"enum": ["passed", "failed", "tool-error"]},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "subject", "message"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^TRACE-[A-Z]+-[0-9]{3}$"},
          "severity": {"enum": ["error", "warning", "info"]},
          "subject": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "evidence": {"type": "string"},
          "remediation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "human_approval_reference": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
